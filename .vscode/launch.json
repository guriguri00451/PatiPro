{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/patipuro-vscode" 
            ],
            "outFiles": [
                "${workspaceFolder}/patipuro-vscode/out/**/*.js"
            ],
            "preLaunchTask": "npm: watch - patipuro-vscode"
        }
    ]
}